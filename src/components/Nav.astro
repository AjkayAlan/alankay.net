---
const links = [
  { label: 'About', href: '#about' },
  { label: 'Resume', href: '#resume' },
  { label: 'Contact', href: '#contact' },
];
---

<nav class="site-nav" aria-label="Primary">
  <div class="wrap site-nav__inner">
    <a class="brand" href="#top">
      <span>alankay.net</span>
      <span class="brand__cursor" aria-hidden="true"></span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-links"
      data-nav-toggle
    >
      <span data-nav-label>Menu</span>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M0 2h14M0 7h14M0 12h14" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>

    <ul class="nav-links" id="site-nav-links">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const list = document.querySelector<HTMLUListElement>('.nav-links');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');

  if (toggle && list && label) {
    toggle.addEventListener('click', () => {
      const isOpen = list.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      label.textContent = isOpen ? 'Close' : 'Menu';
    });

    // Close the menu when a link is chosen.
    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) {
        list.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        label.textContent = 'Menu';
      }
    });
  }
</script>
