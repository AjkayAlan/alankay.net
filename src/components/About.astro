---
import StrandSection from './StrandSection.astro';
import { influences } from '../data/influences';
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="wrap">
    <p class="eyebrow">01 — About</p>
    <h2 class="section-title" id="about-heading">About me</h2>

    <p class="about__lead">
      The people, pursuits, and principles that shaped me are not separate from
      my work — they are the source of it. Four strands make up who I am and how
      I show up: personal, professional, background, and values. Each one trained
      something I still use every day.
    </p>

    <div class="strands">
      {
        influences.map((strand, i) => (
          <StrandSection strand={strand} index={i} />
        ))
      }
    </div>

    <div class="about__close reveal">
      <h2 class="about__close-title">So who am I?</h2>
      <p class="about__close-sign">
        A problem solver with an ambitious attitude — a mentor who likes to teach,
        a builder who loves seeing projects through to the end.
        <strong> I am Alan Kay.</strong>
      </p>
    </div>
  </div>
</section>
