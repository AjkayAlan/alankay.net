---
import StrandSection from './StrandSection.astro';
import { influences } from '../data/influences';
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="wrap">
    <p class="eyebrow">01 · About</p>
    <h2 class="section-title" id="about-heading">About me</h2>

    <p class="about__lead">
      The people, pursuits, and principles that shaped me aren't separate from
      my work. They're its source. Personal, professional, background, and
      values are four building blocks in my DNA, just a few of the things that
      make me who I am. They're the ones I keep coming back to, and each one
      trained something I still use every day.
    </p>

    <div class="strands">
      {
        influences.map((strand, i) => (
          <StrandSection strand={strand} index={i} />
        ))
      }
    </div>

    <div class="about__close reveal">
      <h2 class="about__close-title">So who am I?</h2>
      <p class="about__close-sign">
        I am a problem solver with an ambitious attitude, a mentor who likes to
        teach, and a builder who loves seeing projects through to the end. These
        are just a few of the things that shape me.
        <strong> I am Alan Kay.</strong>
      </p>
    </div>
  </div>
</section>
