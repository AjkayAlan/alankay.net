---
import { influences } from '../data/influences';
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="wrap">
    <p class="eyebrow">01 — About</p>
    <h2 class="section-title" id="about-heading">About me</h2>

    <p class="about__lead">
      I feel that my influences in my life have truly formed what is known as
      “me”. Through my life up to this point, I have had four great influences
      which have lead me towards where I am now. Hockey, band, computers, and my
      parents all created a personality for myself which plays a large role in
      my every day decisions.
    </p>

    <div class="channels">
      {
        influences.map((track, i) => (
          <article
            class="channel reveal"
            id={`track-${track.id}`}
            style={`--channel-color: ${track.color}; --reveal-delay: ${i * 80}ms;`}
          >
            <header class="channel__head">
              <span class="channel__swatch" aria-hidden="true"></span>
              <span class="channel__num">{track.number}</span>
              <h3 class="channel__name">{track.label}</h3>
            </header>
            <div class="channel__body">
              {track.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="about__close reveal">
      <h2 class="about__close-title">So who am I?</h2>
      <p class="about__close-sign">
        A young professional with an ambitious attitude — a dedicated, hard
        worker and a great friend. <strong>I am Alan Kay.</strong>
      </p>
    </div>
  </div>
</section>
