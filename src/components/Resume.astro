<section class="section resume" id="resume" aria-labelledby="resume-heading">
  <div class="wrap">
    <p class="eyebrow">02 — Resume</p>
    <div class="resume__head">
      <h2 class="resume__title" id="resume-heading">Resume</h2>
      <a class="btn btn--primary" href="/files/AlanKayResume.pdf" download>
        Download PDF <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div class="resume__frame">
      <object
        data="/files/AlanKayResume.pdf"
        type="application/pdf"
        aria-label="Alan Kay's resume, PDF"
      >
        <p>Your browser can’t display this PDF inline.</p>
      </object>
    </div>

    <p class="resume__note">
      If you can’t see the resume above, <a href="/files/AlanKayResume.pdf">open the PDF directly</a>.
    </p>
  </div>
</section>
