---

<section class="section resume" id="resume" aria-labelledby="resume-heading">
  <div class="wrap">
    <div class="resume__head">
      <h2 class="resume__title" id="resume-heading">Resume</h2>
      <div class="resume__actions">
        <a class="btn btn--primary" href="/files/AlanKay_Resume.pdf" download>
          Download PDF <span aria-hidden="true">↓</span>
        </a>
        <a
          class="btn btn--ghost"
          href="/files/AlanKay_Resume_ATS.pdf"
          download
        >
          Download ATS version <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="resume__frame">
      <object
        data="/files/AlanKay_Resume.pdf"
        type="application/pdf"
        aria-label="Alan Kay's resume, PDF"
      >
        <p>Your browser can’t display this PDF inline.</p>
      </object>
    </div>

    <p class="resume__note">
      If you can’t see the resume above, <a href="/files/AlanKay_Resume.pdf">open the PDF directly</a>.
      An <a href="/files/AlanKay_Resume_ATS.pdf">ATS-friendly version</a> is also available.
    </p>
  </div>
</section>
